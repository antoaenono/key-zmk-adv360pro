// This file is tangled. Don't edit directly!

#include <behaviors.dtsi>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/// Modifiers
#define HYPER LS(LC(LA(LGUI)))
#define MEH LS(LC(LALT))
#define CAG LC(LA(LGUI))

/// Home-row Modifiers
#define HRML(k1,k2,k3,k4) &hm LMETA k1 &hm LALT k2 &hm LCTRL k3 &hm LSHFT k4
#define HRMR(k1,k2,k3,k4) &hm RSHFT k1 &hm RCTRL k2 &hm RALT k3 &hm RMETA k4

/// Custom Behaviors
#define CTL_ESC &mt LCTRL ESC
#define GUI_TAB &mt LGUI TAB

/// Bluetooth
#define BT0 BT_SEL 0
#define BT1 BT_SEL 1
#define BT2 BT_SEL 2
#define BT3 BT_SEL 3
#define BT4 BT_SEL 4
#define BTCLR BT_CLR

// Layer aliases (auto-generated)
#define BASE 0
#define NAV 1
#define FUN 2
#define MOD 3
#define SOUND 4



// Behaviors
/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
        slt: spacebar_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp GRAVE &kp N1      &kp N2     &kp N3      &kp N4      &kp N5 &tog SOUND                                                             &mo MOD &kp N6 &kp N7      &kp N8      &kp N9     &kp N0      &kp PLUS 
                &kp TAB   &kp Q       &kp W      &kp F       &kp P       &kp B  &none                                                                &none   &kp J  &kp L       &kp U       &kp Y      &kp SQT     &kp MINUS
                &kp ESC   &hm LMETA A &hm LALT R &hm LCTRL S &hm LSHFT T &kp G  &none            &kp LALT       &kp HOME &kp PG_UP &kp RCTRL         &none   &kp M  &hm RSHFT N &hm RCTRL E &hm RALT I &hm RMETA O &kp SEMI 
                &kp LSHFT &kp Z       &kp X      &kp C       &kp D       &kp V                                  &kp END  &kp PG_DN                           &kp K  &kp H       &kp COMMA   &kp DOT    &kp FSLH    &kp RSHFT
                &mo FUN   &kp BSLH    &kp CAPS   &kp LEFT    &kp RIGHT                   &kp ESC &slt NAV SPACE &kp TAB  &kp BSPC  &kp ENTER &kp DEL                &kp UP      &kp DOWN    &kp LBKT   &kp RBKT    &mo FUN  
            >;
        };

        nav {
            display-name = "Navigation";
            bindings = <
                &none   &none     &none    &none     &none     &none &trans                                        &none &none    &none    &none  &none     &none &none
                &none   &none     &none    &none     &none     &none &none                                         &none &none    &none    &none  &none     &none &none
                &none   &kp LMETA &kp LALT &kp LCTRL &kp LSHFT &none &none        &none  &trans &trans &none       &none &kp LEFT &kp DOWN &kp UP &kp RIGHT &none &none
                &none   &none     &none    &none     &none     &none                     &trans &trans                   &none    &none    &none  &none     &none &none
                &mo FUN &none     &none    &none     &none                  &none &trans &none  &none  &none &none                &none    &none  &none     &none &none
            >;
        };

        fun {
            display-name = "Function";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog SOUND                                           &mo MOD &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &trans &trans &none                                                &none   &trans &trans &trans &trans  &trans  &trans 
                &trans &trans &trans &trans &trans &trans &none             &trans &trans &trans &trans        &none   &trans &trans &trans &trans  &trans  &trans 
                &trans &trans &trans &trans &trans &trans                          &trans &trans                       &trans &trans &trans &trans  &trans  &trans 
                &trans &trans &trans &trans &trans                   &trans &trans &trans &trans &trans &trans                &trans &trans &trans  &trans  &trans 
            >;
        };

        mod {
            display-name = "System";
            bindings = <
                &none          &bt BT0 &bt BT1 &bt BT2 &bt BT3    &bt BT4 &none                                                              &trans       &none &none      &none      &none &none &none
                &none          &none   &none   &none   &none      &none   &bootloader                                                        &bootloader  &none &none      &none      &none &none &none
                &studio_unlock &none   &none   &none   &none      &none   &none             &none &none &bt BTCLR &none                      &stp STP_BAT &none &none      &none      &none &none &none
                &none          &none   &none   &none   &macro_ver &none                           &none &none                                             &none &none      &none      &none &none &none
                &none          &none   &none   &none   &none                          &none &none &none &none     &bl BL_TOG &rgb_ug RGB_TOG                    &bl BL_INC &bl BL_DEC &none &none &none
            >;
        };

        sound {
            display-name = "Sound";
            bindings = <
                &trans    &kp F1       &kp F2       &kp F3        &kp F4       &kp F5 &trans                                           &trans &kp F6   &kp F7        &kp F8        &kp F9       &kp F10      &trans     
                &trans    &trans       &kp C_PREV   &kp C_PP      &kp C_NEXT   &trans &trans                                           &trans &trans   &kp C_BRI_DN  &kp C_BRI_UP  &trans       &trans       &trans     
                &trans    &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE    &trans       &trans &trans        &trans &trans &trans &trans        &trans &trans   &trans        &trans        &trans       &trans       &trans     
                &trans    &trans       &trans       &trans        &trans       &trans                      &trans &trans                      &trans   &trans        &trans        &trans       &trans       &trans     
                &trans    &trans       &trans       &trans        &trans                     &trans &trans &trans &trans &trans &trans                 &trans        &trans        &trans       &trans       &trans     
            >;
        };

        // Reserved layers for ZMK Studio
        extra1 {
            display-name = "Purple";
            status = "reserved";
        };

        extra2 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra3 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
